doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Login | Sunny Reef Store 🪸☀️
    style.
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #0369a1 50%, #06b6d4 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 1.5rem;
      }
      .card {
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(16px);
        padding: 2.5rem 2rem;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.35);
        width: 100%;
        max-width: 380px;
        text-align: center;
        border: 2px solid rgba(255, 255, 255, 0.8);
      }
      .badge {
        display: inline-block;
        background: linear-gradient(90deg, #0284c7 0%, #06b6d4 100%);
        color: white;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.35rem 0.95rem;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        margin-bottom: 0.85rem;
        box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
      }
      h2 {
        color: #0f172a;
        font-size: 1.75rem;
        margin-bottom: 0.3rem;
        font-weight: 700;
      }
      p.subtitle {
        color: #64748b;
        font-size: 0.88rem;
        margin-bottom: 1.6rem;
      }
      .form-group {
        text-align: left;
        margin-bottom: 1.2rem;
      }
      label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        color: #0369a1;
        font-size: 0.85rem;
      }
      input {
        width: 100%;
        padding: 0.75rem 0.9rem;
        border: 2px solid #bae6fd;
        border-radius: 12px;
        font-size: 0.95rem;
        outline: none;
        background: #f8fafc;
        transition: all 0.2s ease;
      }
      input:focus {
        border-color: #0284c7;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.2);
      }
      button {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(90deg, #0369a1 0%, #0284c7 50%, #06b6d4 100%);
        color: white;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        margin-top: 0.5rem;
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.35);
        transition: transform 0.1s ease, box-shadow 0.2s ease;
      }
      button:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
      }
      .error {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        padding: 0.7rem;
        border-radius: 10px;
        font-size: 0.85rem;
        margin-bottom: 1.2rem;
      }

  body
    .card
      span.badge 🤿 Scuba & Ocean Gear
      h2 Sunny Reef Store 🪸☀️
      p.subtitle Panel de Administración de Productos
      p.subtitle Usuario de prueba: sol@admin.com / 123456
      p.error#error(hidden)

      form#loginForm
        .form-group
          label(for="email") Usuario / Email
          input#email(type="email" name="email" required placeholder="sol@admin.com")
        .form-group
          label(for="password") Contraseña
          input#password(type="password" name="password" required placeholder="••••••••")
        button(type="submit") Ingresar 🤿

    script.
      const form = document.getElementById("loginForm");
      const errorBox = document.getElementById("error");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorBox.hidden = true;

        const res = await fetch("/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: form.email.value,
            password: form.password.value,
          }),
        });
        const data = await res.json();

        if (res.ok) {
          localStorage.setItem("token", data.token);
          window.location.href = "/products";
        } else {
          errorBox.textContent = data.message;
          errorBox.hidden = false;
        }
      });